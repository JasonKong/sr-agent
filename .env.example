# Local development only. Copy to .env (git-ignored). Never put real secrets in either file.

# Postgres in docker-compose
POSTGRES_USER=sr
POSTGRES_PASSWORD=sr_local_only
POSTGRES_DB=sr_agent
SR_DB_PORT=5432

# Used by every Python package (validated at start-up)
DATABASE_URL=postgresql://sr:sr_local_only@localhost:5432/sr_agent

# MCP server: logs in as a read-only role that cannot read patient values.
# Create it after `make migrate` with `make db-roles`.
MCP_DATABASE_URL=postgresql://sr_mcp:sr_mcp_local_only@localhost:5432/sr_agent
MCP_MASK_SALT=local-only-change-me
# Bearer token for `sr-mcp --transport http` (`make mcp-http`); at least 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_HTTP_TOKEN=replace-with-a-random-token-of-32-or-more-characters

# Diagnosis agent (`uv run sra ask "..."`). It calls the MCP server over HTTP with
# MCP_HTTP_TOKEN, and the model API with this key. Unit tests never use it.
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown):
# SRA_MODEL=claude-opus-5-5
# SRA_EFFORT=medium
# SRA_FALLBACK=default          # retry a classifier refusal on another model; "off" to disable
# SRA_MCP_URL=http://127.0.0.1:8765/mcp
# SRA_MAX_TOOL_CALLS=8
# SRA_TIME_LIMIT_S=60
# SRA_TOKEN_BUDGET=200000

# Knowledge retrieval (`make ingest`, and search_knowledge in the MCP server). Both must
# use the same embedder: bge-small (default, local), minilm (local) or hash (tests only).
# MCP_EMBEDDER=bge-small
# MCP_MODEL_DIR=var/models

# Audit of every diagnosis (T5.3). The agent logs in as a member of sr_auditor, which can
# only insert into and read the audit schema. Create it after `make migrate` with
# `make db-auditor`. Leave unset to run without an audit database.
# SRA_AUDIT_DATABASE_URL=postgresql://sr_audit:sr_audit_local_only@localhost:5432/sr_agent

# The agent's HTTP API (`make api`, T5.4). With a token set, callers must send
# `Authorization: Bearer <SRA_API_TOKEN>`; the console's dev server adds it.
# SRA_API_TOKEN=replace-with-a-random-token
# SRA_API_MAX_CONCURRENT=2
# SRA_API_CORS_ORIGINS=http://localhost:5173
